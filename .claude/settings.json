{
  "permissions": {
    "allow": [],
    "additionalDirectories": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python AI_TOOLS/hooks/pre_edit_check.py",
            "timeout": 10,
            "statusMessage": "pre_edit_check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python AI_TOOLS/hooks/post_edit_check.py",
            "timeout": 10,
            "statusMessage": "post_edit_check"
          }
        ]
      }
    ]
  }
}
