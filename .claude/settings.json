          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/post_edit_check.py",
            "timeout": 10,
            "statusMessage": "post_edit_check"
          }
        ]
      }
    ],
    "Stop": [
